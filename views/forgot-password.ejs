<%- include('partials/head') %>
<div class="ballot-head"><div class="bar"></div><div class="hairlines"></div></div>
<p class="eyebrow">Election committee &amp; observers</p>
<h1>Forgot password</h1>
<p class="sub">For committee and observer accounts only. Voters never have a password —
<a href="/">cast your ballot here</a> with your credential.</p>
<% if (smtp) { %>
<p>Enter your account username. If the account exists and has a recovery email on file, a
single-use reset link will be emailed to it. You will choose a new password on that page —
no password is ever emailed or displayed.</p>
<form method="post" action="/forgot-password" style="max-width:380px">
  <label for="u">Username</label>
  <input id="u" type="text" name="username" required autocomplete="username">
  <button class="btn primary" type="submit">Email me a reset link</button>
</form>
<p class="sub" style="margin-top:18px">No recovery email on your account, or the link never
arrives? Contact platform support — they can generate a one-time reset link for you after
confirming who you are.</p>
<% } else { %>
<div class="notice warn">
  <strong>Email delivery is not configured on this instance</strong>, so reset links cannot be
  emailed. Contact platform support: after confirming who you are, they can generate a
  <strong>one-time reset link</strong> that lets you choose a new password. Your password is
  never emailed, displayed, or stored in plaintext — by anyone, including support.
</div>
<a class="btn" href="/login">Back to sign in</a>
<% } %>
<%- include('partials/foot') %>
