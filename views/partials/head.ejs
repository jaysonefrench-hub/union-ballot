<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= title %> — <%= brand.org %></title>
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" href="<%= brand.logo %>">
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<% if (brand.demo) { %>
<div class="demobar" role="status"><strong>Demo</strong><%= brand.demoNotice %></div>
<% } %>
<% if (electionIsTest) { %>
<div class="demobar election-testbar" role="status"><strong>DEMO / TEST</strong> — not a binding election</div>
<% } %>
<header class="topbar">
  <a class="brand" href="/">
    <img class="brand-logo" src="<%= brand.logo %>" alt="<%= brand.org %> logo">
    <span class="brand-text">
      <span class="brand-org"><%= brand.org %></span>
      <%# Signed-in committee/observer pages name THE local being managed —
          the same person may hold accounts at more than one local, so every
          page must be unambiguous about whose roster and votes these are. %>
      <span class="brand-sub"><% if (currentLocal) { %><strong><%= currentLocal.name %></strong> · <% } else if (brand.local) { %><%= brand.local %> · <% } %><%= brand.system %></span>
    </span>
  </a>
  <nav>
    <% if (user && user.role === 'admin') { %>
      <a href="/admin">Elections</a>
      <a href="/admin/members">Roster</a>
      <a href="/admin/users">Accounts</a>
      <a href="/observe/audit">Audit log</a>
    <% } else if (user && user.role === 'observer') { %>
      <a href="/observe">Observer station</a>
      <a href="/observe/audit">Audit log</a>
    <% } else if (platformAdmin) { %>
      <a href="/platform">Platform</a>
    <% } %>
  </nav>
  <div class="who">
    <% if (user) { %>
      <span><%= user.name %> (<%= user.role %><% if (currentLocal) { %> — <%= currentLocal.name %><% } %>)</span>
      <form method="post" action="/logout"><button type="submit">Sign out</button></form>
    <% } else if (platformAdmin) { %>
      <span><%= platformAdmin.name %> (platform administrator)</span>
      <form method="post" action="/platform/logout"><button type="submit">Sign out</button></form>
    <% } else { %>
      <a href="/login">Committee sign-in</a>
    <% } %>
  </div>
</header>
<main id="main">
<% if (flash) { %><div class="flash <%= flash.type %>"><%= flash.text %></div><% } %>
