<%- include('partials/head') %>
<div class="ballot-head"><div class="bar"></div><div class="hairlines"></div></div>
<p class="eyebrow">Election committee &amp; observers</p>
<h1>Choose a new password</h1>
<p class="sub">Setting a new password for account <span class="mono"><%= username %></span>.
This link works exactly once; once you submit, it is void.</p>
<form method="post" action="/reset-password" style="max-width:380px">
  <input type="hidden" name="token" value="<%= token %>">
  <label for="p1">New password (10+ characters)</label>
  <input id="p1" type="password" name="password" minlength="10" required autocomplete="new-password">
  <label for="p2">Repeat new password</label>
  <input id="p2" type="password" name="password_confirm" minlength="10" required autocomplete="new-password">
  <button class="btn primary" type="submit">Set new password</button>
</form>
<p class="sub" style="margin-top:18px">Your password is stored only as a bcrypt hash — never in
plaintext, never in a log, never in an email. The completion of this reset is recorded in the
tamper-evident audit log (your password is not).</p>
<%- include('partials/foot') %>
